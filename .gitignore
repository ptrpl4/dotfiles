# Folder view configuration files
.DS_Store
Desktop.ini

# Thumbnail cache files
._*
Thumbs.db

# Files that might appear on external disks
.Spotlight-V100
.Trashes

# Private Information
shell/private
# pre-move location; keep until every machine is migrated
.private
.private-gitconfig
.netrc
.npmrc
.secrets

# Ignore backups
/backups

# glab — settings/glab/{config.yml,aliases.yml} are machine-neutral seeds.
# local/ is the live config glab reads and rewrites: hostname, username and
# update timestamps all land there, so none of it is tracked.
settings/glab/local/

# obsidian
settings/obsidian/default/workspace.json
settings/obsidian/default/plugins/*/main.js
settings/obsidian/default/plugins/*/styles.css
settings/obsidian/default/plugins/*/*.sh

# Markdown notes (keep only README, repo-level docs, and settings/)
*.md
!README.md
!settings/**/*.md

# llm

.claude

# Claude skills (machine-local, not shared via dotfiles)
settings/claude/skills/

# Per-machine notes and findings (not shared via dotfiles)
/machine
