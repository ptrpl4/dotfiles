# Shared by zprompt and bash_prompt. Returns plain text — no colour, no
# brackets — so each shell can wrap it in its own non-printing markers.
#
# for-each-ref reads refs only, so the cost is flat in worktree size. `git
# status` was tried and is much worse where it matters: on a 2469-file repo it
# runs 16 ms with a warm index but 280-300 ms once stat data is stale, which is
# the state after every checkout, rebase or build — exactly when the prompt is
# looked at. for-each-ref stays at 12 ms throughout. It does grow with the
# branch count (200 branches ≈ 25 ms) since it resolves upstream tracking per
# ref, which is the better trade.
prompt_git() {
    local out line rest head up track ahead behind sync=''

    out=$(git --no-optional-locks for-each-ref \
              --format='%(HEAD)|%(refname:short)|%(upstream)|%(upstream:track,nobracket)' \
              refs/heads 2>/dev/null) || return

    while IFS= read -r line; do
        case "$line" in '*|'*) rest="${line#\*|}" ;; *) continue ;; esac
        # Parse right to left: a branch name may contain '|', the other two
        # fields cannot.
        track="${rest##*|}"; rest="${rest%|*}"
        up="${rest##*|}";    head="${rest%|*}"
        break
    done <<EOF
$out
EOF

    # Detached HEAD carries the marker on no ref at all. rev-parse honours
    # core.abbrev, so the oid matches what every other git command here prints.
    [ -n "$head" ] || head=$(git --no-optional-locks rev-parse --short HEAD 2>/dev/null) || return

    # An empty track means in sync; without an upstream it means nothing, hence
    # the separate %(upstream) field.
    if [ -n "$up" ]; then
        if [ "$track" = gone ]; then
            sync=':gone'
        else
            case "$track" in *'behind '*) behind="${track##*behind }"; behind="${behind%%,*}" ;; esac
            case "$track" in *'ahead '*)  ahead="${track##*ahead }";   ahead="${ahead%%,*}"   ;; esac
            [ -n "$behind" ] && sync="${sync}↓${behind}"
            [ -n "$ahead" ]  && sync="${sync}↑${ahead}"
            sync=":${sync:-✓}"
        fi
    fi

    printf '%s%s' "$head" "$sync"
}
