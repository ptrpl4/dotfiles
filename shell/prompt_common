# Shared by zprompt and bash_prompt. Returns plain text — no colour, no
# brackets — so each shell can wrap it in its own non-printing markers.
#
# One `git status` replaces the four rev-parse/rev-list forks this used to
# make: ~13 ms per prompt against ~46 ms. --no-optional-locks keeps the prompt
# from taking the index lock behind a concurrent git; -uno skips the untracked
# scan, which nothing here reports on.
prompt_git() {
    local out line head oid ab ahead behind sync=''

    out=$(git --no-optional-locks status -uno --porcelain=v2 --branch 2>/dev/null) || return

    # Header lines come first and all start with '#'; stop at the first entry.
    while read -r line; do
        case "$line" in
            '# branch.head '*) head="${line#\# branch.head }" ;;
            '# branch.oid '*)  oid="${line#\# branch.oid }"   ;;
            '# branch.ab '*)   ab="${line#\# branch.ab }"     ;;
            '#'*) ;;
            *) break ;;
        esac
    done <<EOF
$out
EOF

    [ "$head" = '(detached)' ] && head="${oid:0:7}"

    # branch.ab is absent when there is no upstream, so no separate probe.
    if [ -n "$ab" ]; then
        ahead="${ab%% *}"    # +N
        behind="${ab##* }"   # -N
        [ "${behind#-}" -gt 0 ] && sync="${sync}↓${behind#-}"
        [ "${ahead#+}" -gt 0 ] && sync="${sync}↑${ahead#+}"
        sync=":${sync:-✓}"
    fi

    printf '%s%s' "$head" "$sync"
}
