source "${HOME}/.prompt_common"

# Clock, exit status and job count are prompt escapes (%D, %(?..), %(1j..)) —
# no forks, and no precmd bookkeeping to be clobbered by direnv or zoxide. The
# git segment is the only work done per prompt.
#
# PS1 is rebuilt in precmd rather than left to PROMPT_SUBST: zsh only counts
# %{ %} that it expanded itself, so escapes arriving through $(...) corrupt the
# width and glitch redraws on long lines. Assembling here also lets the branch
# name be %-escaped, so 'feat/100%off' cannot inject prompt escapes.
autoload -Uz add-zsh-hook

_zprompt() {
    local git="$(prompt_git)"
    [[ -n "$git" ]] && git="%F{8}─[%fgit%F{8}:%f${git//\%/%%}%F{8}]%f"

    PS1=$'\n'"%F{8}┌─[%f%D{%H:%M}%F{8}]─[%f%n%F{8}]─[%f%c%F{8}]%f"
    PS1+="$git"
    PS1+="%(?..%F{8}─[%ferr %?%F{8}]%f)"
    PS1+="%(1j.%F{8}─[%fjobs %j%F{8}]%f.)"
    PS1+=$'\n'"%F{8}└─>%f "
}
add-zsh-hook precmd _zprompt
_zprompt   # populate PS1 now; precmd only fires at the first prompt

PS2="%F{8}───>%f "

# Deliberately not exported: prompts are shell-local. An exported PS1 renders as
# literal zsh escapes in interactive bash children, and defeats the
# `if [ -z "$PS1" ]; then return; fi` interactivity guard that this machine's own
# /etc/bashrc opens with (Debian's /etc/bash.bashrc uses the same test).
