[[ -r "${HOME}/.prompt_common" ]] && source "${HOME}/.prompt_common"

# Literal SGR, not %F{8}: terminfo drops grey at 8 colours and under xterm-ghostty.
_zp_gray=$'%{\e[90m%}'
_zp_fg=$'%{\e[39m%}'

# Built in precmd, not PROMPT_SUBST: zsh miscounts %{ %} arriving via $(...),
# and the branch name gets %-escaped here.
autoload -Uz add-zsh-hook

_zprompt() {
    local git
    if (( $+functions[prompt_git] )); then
        git="$(prompt_git)"
        [[ -n "$git" ]] && git="${_zp_gray}─[${_zp_fg}git${_zp_gray}:${_zp_fg}${git//\%/%%}${_zp_gray}]${_zp_fg}"
    fi

    PS1=$'\n'"${_zp_gray}┌─[${_zp_fg}%D{%H:%M}${_zp_gray}]─[${_zp_fg}%n${_zp_gray}]─[${_zp_fg}%c${_zp_gray}]${_zp_fg}"
    PS1+="$git"
    PS1+="%(?..${_zp_gray}─[${_zp_fg}err %?${_zp_gray}]${_zp_fg})"
    PS1+="%(1j.${_zp_gray}─[${_zp_fg}jobs %j${_zp_gray}]${_zp_fg}.)"
    PS1+=$'\n'"${_zp_gray}└─>${_zp_fg} "
}
add-zsh-hook precmd _zprompt

PS2="${_zp_gray}───>${_zp_fg} "

# Not exported: bash children would show zsh escapes and /etc/bashrc's
# `[ -z "$PS1" ]` interactivity guard would break.
