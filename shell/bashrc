# Compatibility path — the configured setup is zsh, but bash is the login shell
# on some machines. Read for interactive bash, `bash -l`, and `ssh host 'cmd'`
# where bash is the login shell; not for `bash -c` or `make`, which have no
# .zshenv equivalent.
_dfp_init="${DOTFILES:-$HOME/dotfiles}/shell/path.sh"
[ -r "$_dfp_init" ] && . "$_dfp_init"
unset _dfp_init
export BASH_SILENCE_DEPRECATION_WARNING=1

# ─── Interactive only ─────────────────────────────────────────────────────────
[[ $- != *i* ]] && return

HISTSIZE=10000
HISTFILESIZE=10000
HISTCONTROL=ignoreboth  # skip dupes + space-prefixed
shopt -s histappend

for file in ~/.{bash_prompt,aliases,private}; do
    [[ -r "$file" ]] && source "$file"
done
unset file
