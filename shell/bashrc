# For machines where bash is the login shell. Not read by `bash -c`.
_dfp_init="${DOTFILES:-$HOME/dotfiles}/shell/env.sh"
[ -r "$_dfp_init" ] && . "$_dfp_init"
unset _dfp_init
export BASH_SILENCE_DEPRECATION_WARNING=1

# ─── Interactive only ─────────────────────────────────────────────────────────
[[ $- != *i* ]] && return

HISTSIZE=10000
HISTFILESIZE=10000
HISTCONTROL=ignoreboth  # skip dupes + space-prefixed
shopt -s histappend

for file in ~/.{bash_prompt,aliases,private}; do
    [[ -r "$file" ]] && source "$file"
done
unset file
