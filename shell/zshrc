# Interactive zsh only.

# Start profiling
if [[ -n $PROFILE_STARTUP ]]; then
  zmodload zsh/zprof
fi

# History
HISTSIZE=10000
SAVEHIST=10000
HISTFILE="${HOME}/.zsh_history"
setopt INC_APPEND_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_EXPIRE_DUPS_FIRST
setopt EXTENDED_HISTORY

# Shell behavior
setopt CORRECT
setopt INTERACTIVE_COMMENTS

# Completions — interactive-only, so they live here rather than in .zprofile.
# fpath must be extended before compinit runs.
if [[ -d /opt/homebrew/share/zsh/site-functions ]]; then
  fpath=(/opt/homebrew/share/zsh/site-functions $fpath)
fi

autoload -Uz compinit
# Only rebuild the completion cache once a day. Array assignment, not [[ -n … ]]:
# zsh does no filename generation inside [[ ]], so the glob would be a literal
# and the test always true — compinit -C forever, and new fpath entries never
# picked up. Bare qualifiers here also avoid needing EXTENDED_GLOB.
_zcompdump=(${ZDOTDIR:-$HOME}/.zcompdump(Nmh-24))
if (( $#_zcompdump )); then
  compinit -C  # fresh enough, skip the security check
else
  compinit     # rebuild
fi
unset _zcompdump

for file in ~/.{zprompt,aliases,private}; do
  [[ -r "$file" ]] && source "$file"
done
unset file

if [[ -n $PROFILE_STARTUP ]]; then
  zprof
fi
